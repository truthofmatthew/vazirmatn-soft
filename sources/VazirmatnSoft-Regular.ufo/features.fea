 script DFLT;
     language dflt ;
      lookup ss01StyleSet1inArabiclookup11;

 script arab;
     language dflt ;
      lookup ss01StyleSet1inArabiclookup11;
     language FAR  exclude_dflt;
      lookup ss01StyleSet1inArabiclookup11;
     language KUR  exclude_dflt;
      lookup ss01StyleSet1inArabiclookup11;
     language URD  exclude_dflt;
      lookup ss01StyleSet1inArabiclookup11;

 script latn;
     language dflt ;
      lookup ss01StyleSet1inArabiclookup11;
} ss01;
