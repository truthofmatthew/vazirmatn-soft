# --- Vazirmatn Soft extras ---
lookup softToman {
    sub uniFE97 uniFEEE uniFEE3 uniFE8E uni0646 uni0621 by toman.compact1;
    sub uniFE97 uniFEEE uniFEE3 uniFE8E uni0646 afii61664 uni0621 by toman.compact1;
    sub uni0631 uniFBFE uniFE8E uni0644 uni0621 by rial.compact;
    sub uni0631 uniFBFE uniFE8E uni0644 afii61664 uni0621 by rial.compact;
} softToman;

# no script/language here, so it lands in every language system (FAR, KUR, URD, dflt): browsers
# pick FAR on lang="fa" pages
feature liga {
    lookup softToman;
} liga;

feature salt {
    sub toman.compact1 from [toman.compact2 toman.compact3];
} salt;

feature ss02 {
    featureNames { name "Compact toman, two-line"; };
    sub toman.compact1 by toman.compact2;
} ss02;

feature ss03 {
    featureNames { name "Lowered digits"; };
    pos [uni06F0 uni06F0.tnum uni06F1 uni06F1.tnum uni06F2 uni06F2.tnum uni06F3 uni06F3.tnum uni06F4 uni06F4.tnum uni06F5 uni06F5.tnum uni06F6 uni06F6.tnum uni06F7 uni06F7.tnum uni06F8 uni06F8.tnum uni06F9 uni06F9.tnum uni0660 uni0660.tnum uni0661 uni0661.tnum uni0662 uni0662.tnum uni0663 uni0663.tnum uni0664 uni0664.tnum uni0665 uni0665.tnum uni0666 uni0666.tnum uni0667 uni0667.tnum uni0668 uni0668.tnum uni0669 uni0669.tnum] <0 -300 0 0>;
} ss03;

feature ss04 {
    featureNames { name "Nastaliq-style final heh"; };
    sub uni0647 by uni06C1;
    sub uniFEEA by uniFBA7;
} ss04;
